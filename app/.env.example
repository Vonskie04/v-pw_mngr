# Backend server port (Railway provides PORT automatically in production)
PORT=3001

# Railway PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/password_manager

# Base64-encoded 32-byte key used to encrypt credential values in the database
CREDENTIALS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Optional comma-separated allow-list for browser origins
CORS_ORIGIN=http://localhost:5173

# Frontend API base URL (leave blank when API is served on same domain)
VITE_API_BASE_URL=
